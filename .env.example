NODE_ENV=development
PORT=3000

# MongoDB (external, per reference)
MONGODB_URL=mongodb://127.0.0.1:27017/scanflow

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=10

# SMTP (optional — OTP falls back to console in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@scanflow.local

# Frontend origin (used for future OAuth redirects / CORS)
CLIENT_URL=http://localhost:7052

# Dev-only OTP bypass (NODE_ENV != production)
# BYPASS_EMAIL accepts a fixed OTP without email delivery; BYPASS_OTP is the fixed code.
BYPASS_EMAIL=dev@scanflow.com
BYPASS_OTP=777777

# Docker compose
BEHIND_REVERSE_PROXY=false
HOST_PORT=3000
REPLICA_PORT=3004
CONTAINER_PORT=3000
REPLICAS=2
IMAGE_TAG=latest
MEMORY_LIMIT=2G
MEMORY_RESERVATION=512M
# Docker compose (in-container Mongo URL; override to point at a containerized/host DB)
DOCKER_MONGODB_URL=mongodb://host.docker.internal:27017/scanflow

# Redis / Queue
REDIS_URL=redis://localhost:6379

# Webhook worker
WEBHOOK_WORKER_CONCURRENCY=100
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_BATCH_SIZE=100
WEBHOOK_RETRY_LIMIT=3

# Scan quota counter (tracking only, no enforcement yet)
SCAN_QUOTA_PERIOD=monthly
