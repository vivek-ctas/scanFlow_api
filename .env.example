NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URL=mongodb://127.0.0.1:27017/scanflow

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=10

# SMTP (optional — OTP falls back to console in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@scanflow.local

# Frontend origin (used for future OAuth redirects / CORS)
CLIENT_URL=http://localhost:4200